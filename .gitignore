# ── Secrets (NEVER commit these!) ──────────────────────────────────
.env
.da-vinci.env
.env.local
.env.*.local
*.secret

# ── Generated assets & test output ─────────────────────────────────
assets/generated/
!assets/generated/.gitkeep
/tmp/
/test-output/
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.mp3
*.wav
# Exceptions: keep gallery/example assets versioned
!docs/examples/**/*.png
!docs/examples/**/*.jpg
!docs/examples/**/*.svg
!docs/examples/**/*.gif
!docs/**/*.png
# El icono de la app es codigo, no un asset generado: generate_context! no
# compila sin el.
!src-tauri/icons/**
!docs/**/*.svg

# ── Node ────────────────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
!ui/package-lock.json
yarn.lock
dist/
ui/node_modules/

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.claude/settings.local.json

# ── Logs ───────────────────────────────────────────────────────────
*.log
logs/

# ── Build artifacts ────────────────────────────────────────────────
src-tauri/binaries/
!src-tauri/binaries/.gitkeep

# orch runtime state
.orchestrator/state/*
!.orchestrator/state/.gitkeep

# ── Rust / Tauri ────────────────────────────────────────────────────
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/
tasks.json.bak-*

# Temporal de scripts/fetch-node.mjs — un tarball de ~54 MB se colo al repo
# en el PR #30 por no estar listado aca.
.node-fetch-tmp/
