# ─────────────────────────────────────────────────────────────────
#  Da Vinci — Environment Variables Template
# ─────────────────────────────────────────────────────────────────
#
#  Copy this file to one of these locations:
#    - ./.da-vinci.env               (project-specific)
#    - ~/.config/da-vinci/.env       (user-level, recommended)
#    - $DAVINCI_ENV_FILE             (custom path override)
#
#  Then run: chmod 600 <path>  (secure the file)
#
#  All keys are OPTIONAL — load only the providers you use.
# ─────────────────────────────────────────────────────────────────

# ── OpenAI (gpt-image-1, gpt-image-2) ────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google Gemini (Nano-Banana, Imagen 4, Veo 3) ─────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── FAL.ai (FLUX, Recraft, Ideogram, Kling, Sora 2, Veo 3.1) ─────
# https://fal.ai/dashboard/keys
# Format: key_id:key_secret
FAL_API_KEY=

# ── KIE.ai gateway (Sora 2, Kling, Midjourney, Wan) ──────────────
# https://kie.ai/dashboard
KIE_API_KEY=

# ── HeyGen (HyperFrames + Avatar Video) ──────────────────────────
# https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=

# ── ElevenLabs (TTS + SFX) ───────────────────────────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=


# ─────────────────────────────────────────────────────────────────
#  ALTERNATIVE: Infisical (advanced setup)
# ─────────────────────────────────────────────────────────────────
#  If you use Infisical (self-hosted or cloud), set these instead
#  and Da Vinci will auto-detect and fetch the API keys above.
#  See docs/setup.md for full guide.
# ─────────────────────────────────────────────────────────────────
# INFISICAL_URL=https://your-infisical-instance.com
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# DAVINCI_PROJECT_ID=
# DAVINCI_ENV=prod
